# Router
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8100
# A chat client's permanent model ID is `local`. The OpenAI key is normally
# stored by Model Deck in macOS Keychain; OPENAI_API_KEY remains a headless
# fallback.

# Scout backend
SCOUT_ALIAS=scout
SCOUT_BASE_URL=http://127.0.0.1:8000/v1
SCOUT_MODEL_ID=scout
SCOUT_API_KEY=
SCOUT_REASONING=auto
SCOUT_ENABLE_THINKING=true

# Builder backend
BUILDER_ALIAS=builder
BUILDER_BASE_URL=http://127.0.0.1:8002/v1
BUILDER_MODEL_ID=builder
BUILDER_API_KEY=
# Leave blank to use the Builder server's reasoning defaults.
BUILDER_REASONING=
BUILDER_ENABLE_THINKING=
